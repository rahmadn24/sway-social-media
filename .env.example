# Sway — copy to .env (local dev) or .env on the VPS (see DEPLOY.md).
# NEVER commit a filled-in .env. Generate secrets with:
#   openssl rand -hex 32

# --- Database ----------------------------------------------------------
# Postgres. Local dev: the database you created for testing.
# VPS: a `sway` database inside the Postgres that already runs for n8n.
# Format: postgresql://<user>:<password>@<host>:5432/sway
DATABASE_URL=postgresql://sway:CHANGE-ME@localhost:5432/sway

# --- Server secrets (required in production) ---------------------------
# Secret that signs session cookies. The app refuses to start in
# production without it.
SWAY_SESSION_SECRET=
# 32-byte key (64 hex chars) that encrypts per-user AI provider keys at
# rest (AES-256-GCM). The app refuses to start in production without it.
# Losing this key makes every stored AI key unreadable — back it up.
SWAY_ENCRYPTION_KEY=

# --- Admin account (seed only) -----------------------------------------
# The seed creates/updates this admin user ONLY when both are set.
# After the first seed, change the password via the seed again or delete
# the lines — the user stays in the database either way. The demo account
# needs no credentials here: it is created by the seed with a random
# password nobody knows, and the login page's "Try the demo" button is
# the only way in as demo.
SWAY_ADMIN_EMAIL=admin@sway.local
SWAY_ADMIN_PASSWORD=

# --- AI provider -------------------------------------------------------
# Active provider: anthropic | openai | gemini | groq | openrouter |
#                  deepseek | ollama | custom
AI_PROVIDER=anthropic

# Generic key for the active provider. Each provider also honors its own
# variable below; set whichever matches the provider you use.
AI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# OLLAMA_API_KEY=
# CUSTOM_AI_API_KEY=

# Optional overrides. Per-provider defaults are built in; AI_BASE_URL is
# required for AI_PROVIDER=custom.
# AI_MODEL=claude-sonnet-4-5-20250929
# AI_BASE_URL=https://api.anthropic.com/v1

# --- Publishing ---------------------------------------------------------
# sandbox (default): posts are validated and simulated, nothing leaves
# this machine. live: publishing calls the adapters registered in
# lib/publishing.ts and fails loudly for platforms that have none.
SOCIAL_PUBLISHING_MODE=sandbox
